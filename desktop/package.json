{
  "name": "apex-gp-desktop",
  "productName": "Apex GP",
  "version": "0.1.0",
  "private": true,
  "description": "Apex GP for Steam: the browser game in a desktop window, with the Steamworks overlay and achievements.",
  "main": "main.cjs",
  "scripts": {
    "start": "npm --prefix .. run build && electron .",
    "smoke": "npm --prefix .. run build && electron . --smoke",
    "dist:mac": "npm --prefix .. run build && electron-builder --mac dir --universal",
    "dist:win": "npm --prefix .. run build && electron-builder --win dir --x64",
    "dist:linux": "npm --prefix .. run build && electron-builder --linux dir --x64"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.reidcoleman.apexgp",
    "productName": "Apex GP",
    "directories": { "output": "../release" },
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [{ "from": "../dist", "to": "dist" }],
    "extraFiles": [{ "from": "steam_appid.txt", "to": "steam_appid.txt" }],
    "asarUnpack": ["node_modules/steamworks.js/**"],
    "mac": { "category": "public.app-category.racing-games", "icon": "icon.png", "hardenedRuntime": false },
    "win": { "icon": "icon.png" },
    "linux": { "icon": "icon.png", "category": "Game" }
  }
}
